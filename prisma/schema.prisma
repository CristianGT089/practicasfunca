generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ESTUDIANTE
  ADMIN
}

// Un área/programa (Farmacia, Enfermería, Primera Infancia, ...). Tabla en vez de enum
// para poder agregar/desactivar módulos sin migración de schema.
enum TipoModulo {
  CASOS // usa el motor de escenarios calificados (checklist, vidas, informe)
  SIMULADOR // herramienta de práctica libre, sin nota; abre su propia pantalla
}

model Modulo {
  id            String     @id @default(cuid())
  slug          String     @unique // ej: "farmacia", "enfermeria", "primera_infancia"
  nombre        String
  descripcion   String?
  colorTema     String? // ej: "#2563eb", para diferenciar la UI por módulo
  tipo          TipoModulo @default(CASOS)
  rutaSimulador String? // solo para tipo SIMULADOR: a dónde lleva "Abrir" en /panel
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now())

  matriculas Matricula[]
  escenarios Escenario[]
  turnos     Turno[]

  @@map("modulos")
}

// Inscripción de un usuario (estudiante o admin) a un módulo. Un usuario puede estar
// matriculado en varios módulos a la vez con una sola cuenta.
model Matricula {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  moduloId  String
  modulo    Modulo   @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  creadoEn  DateTime @default(now())

  @@unique([usuarioId, moduloId])
  @@map("matriculas")
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  usuario      String   @unique
  passwordHash String
  rol          Rol      @default(ESTUDIANTE)
  activo       Boolean  @default(true)
  // Cuenta creada para un puesto de una sala de cómputo (ej. "Dispensación 2"), no para un
  // estudiante inscrito de forma permanente. Se puede limpiar en bloque tras la sesión.
  temporal     Boolean  @default(false)
  // Solo para cuentas temporales: a qué pantalla entra derecho al iniciar sesión, sin pasar
  // por /panel (ej. "/panel/dispensacion"). Null = panel normal (estudiantes permanentes).
  rutaDirecta  String?
  creadoEn     DateTime @default(now())

  intentos            Intento[]
  intentosTurno       IntentoTurno[]
  matriculas          Matricula[]
  sesionesDispensacion SesionDispensacion[]

  @@map("usuarios")
}

enum OrigenMedicamento {
  PRACTICA // dato ficticio, usado en los escenarios/checklist calificados
  CATALOGO_REAL // importado del inventario real (Excel), solo para consulta libre del estudiante
}

// Catálogo de medicamentos del "software" simulado de Farmacia. Un mismo modelo cubre
// tanto los medicamentos ficticios de los escenarios calificados como el catálogo real
// importado del inventario (ver `origen`), para no duplicar el resto del esquema.
model Medicamento {
  id              String            @id @default(cuid())
  origen          OrigenMedicamento @default(PRACTICA)
  nombre          String
  principioActivo String
  presentacion    String // ej: "Tableta 500mg", "Jarabe 120ml"
  requiereReceta  Boolean           @default(false)
  esControlado    Boolean           @default(false) // requiere receta especial / registro extra
  stock           Int               @default(0)
  precio          Int // en pesos, entero
  loteVencimiento DateTime?
  tags            String[] // ej: ["antiinflamatorio", "penicilina"] para cruces de alergia
  creadoEn        DateTime          @default(now())

  // Campos de ficha técnica, propios del catálogo real (origen = CATALOGO_REAL), tal como
  // vienen en el inventario importado. Quedan opcionales porque el catálogo de práctica no
  // los usa.
  laboratorio      String?
  formaFarmaceutica String?
  concentracion    String?
  registroInvima   String?
  numeroLote       String?

  // Clave de deduplicación del catálogo real: principioActivo + presentacion + numeroLote,
  // normalizados (trim + mayúsculas) para que "Amoxicilina" y "AMOXICILINA " no cuenten como
  // medicamentos distintos. Solo se llena para origen = CATALOGO_REAL; el índice único de abajo
  // es parcial (ver migración) para no afectar los medicamentos de práctica.
  claveUnica String?

  movimientos          MovimientoInventario[]
  itemsEscenario       FarmaciaItemEscenario[]
  recetasElectronicas  RecetaElectronica[]
  renglonesFormula     RenglonFormula[]      @relation("MedicamentoRenglonesFormula")
  entregasDispensacion EntregaDispensacion[] @relation("MedicamentoEntregasDispensacion")

  @@map("medicamentos")
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

model MovimientoInventario {
  id            String         @id @default(cuid())
  medicamentoId String
  medicamento   Medicamento    @relation(fields: [medicamentoId], references: [id])
  tipo          TipoMovimiento
  cantidad      Int
  motivo        String?
  creadoEn      DateTime       @default(now())

  @@map("movimientos_inventario")
}

// Pacientes ficticios usados dentro de los escenarios de Farmacia
model Paciente {
  id              String    @id @default(cuid())
  nombre          String
  cedula          String    @unique
  edad            Int
  alergias        String[] // tags que cruzan contra Medicamento.tags
  antecedentes    String? // texto libre: enfermedades, medicación crónica
  fechaNacimiento DateTime?
  lugarNacimiento String?
  tipoSangre      String?
  creadoEn        DateTime  @default(now())

  escenarios        EscenarioFarmacia[]
  recetas           RecetaElectronica[]
  casosDispensacion CasoDispensacion[] @relation("PacienteCasosDispensacion")

  @@map("pacientes")
}

enum ActitudCedula {
  ENTREGA
  SE_REHUSA
}

// Historial de fórmulas electrónicas que el técnico puede consultar en línea
// por cédula cuando el paciente no trae receta física.
model RecetaElectronica {
  id                 String      @id @default(cuid())
  pacienteId         String
  paciente           Paciente    @relation(fields: [pacienteId], references: [id])
  medicamentoId      String
  medicamento        Medicamento @relation(fields: [medicamentoId], references: [id])
  medico             String
  cantidadAutorizada Int
  cantidadRedimida   Int         @default(0)
  fechaEmision       DateTime
  fechaVigencia      DateTime
  creadoEn           DateTime    @default(now())

  entregas EntregaDispensacion[] @relation("RecetaEntregas")

  @@map("recetas_electronicas")
}

// Un caso práctico completo que el estudiante debe resolver. Genérico: no sabe nada del
// dominio de un módulo específico — lo específico vive en una tabla de extensión 1-a-1
// (EscenarioFarmacia, EscenarioEnfermeria, EscenarioPrimeraInfancia, ...).
model Escenario {
  id                 String  @id @default(cuid())
  moduloId           String
  modulo             Modulo  @relation(fields: [moduloId], references: [id])
  titulo             String
  descripcion        String // versión guiada (modo fácil): contexto con pistas explícitas
  descripcionDificil String? // versión modo difícil: solo los datos mínimos, sin pistas. Si es null, se reusa `descripcion`.
  soloTurno          Boolean @default(false) // si es true, no aparece en la lista de práctica suelta, solo dentro de un Turno

  // Código del resultado esperado, definido por el vocabulario del módulo (ej. Farmacia:
  // "VENTA_CORRECTA" / "RECHAZO_CORRECTO"; Enfermería: "ADMINISTRAR_CORRECTO" / "NO_ADMINISTRAR_CORRECTO").
  resultadoEsperado String

  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  pasos      PasoEsperado[]
  intentos   Intento[]
  turnoItems TurnoItem[]

  farmacia   EscenarioFarmacia?
  enfermeria EscenarioEnfermeria?
  infancia   EscenarioPrimeraInfancia?

  @@map("escenarios")
}

// Extensión de Escenario específica del módulo Farmacia: todo lo que antes vivía
// directamente en Escenario (paciente, receta física/online, cédula).
model EscenarioFarmacia {
  id          String    @id @default(cuid())
  escenarioId String    @unique
  escenario   Escenario @relation(fields: [escenarioId], references: [id], onDelete: Cascade)

  pacienteId       String?
  paciente         Paciente?      @relation(fields: [pacienteId], references: [id])
  recetaPresentada Boolean        @default(false) // si el cliente trae una receta médica física para el medicamento solicitado
  notaRecetaFisica String? // nota adicional opcional (se muestra debajo del documento, ej. contexto de una irregularidad)
  actitudCedula    ActitudCedula? // solo aplica cuando recetaPresentada es false: cómo reacciona el cliente al pedirle la cédula

  // Datos impresos en la receta física, para renderizarla como documento en vez de una frase.
  // recetaFisicaPacienteNombre puede diferir del nombre real del paciente (útil para casos de
  // suplantación); si es null, se usa el nombre del paciente vinculado al escenario.
  recetaFisicaPacienteNombre  String?
  recetaFisicaMedicamento     String?
  recetaFisicaPosologia       String?
  recetaFisicaCantidad        String?
  recetaFisicaCantidadTachada String? // si está presente, se muestra tachada antes de la cantidad final (corrección a mano)
  recetaFisicaMedico          String?
  recetaFisicaRegistroMedico  String?
  recetaFisicaFechaEmision    DateTime?
  recetaFisicaDiasVigencia    Int?
  recetaFisicaControlado      Boolean   @default(false) // si debe mostrar el sello de "control especial"

  items FarmaciaItemEscenario[]

  @@map("escenarios_farmacia")
}

// Medicamento(s) implicados en el escenario de Farmacia y la cantidad esperada si aplica
model FarmaciaItemEscenario {
  id                  String            @id @default(cuid())
  escenarioFarmaciaId String
  escenarioFarmacia   EscenarioFarmacia @relation(fields: [escenarioFarmaciaId], references: [id], onDelete: Cascade)
  medicamentoId       String
  medicamento         Medicamento       @relation(fields: [medicamentoId], references: [id])
  cantidadEsperada    Int?

  @@map("items_escenario_farmacia")
}

// ---------- Módulo Enfermería ----------

// Pacientes ficticios propios del módulo de Enfermería (contexto hospitalario/clínico,
// distinto del paciente de mostrador de Farmacia).
model PacienteEnfermeria {
  id           String   @id @default(cuid())
  nombre       String
  edad         Int
  alergias     String[]
  antecedentes String?
  habitacion   String? // ej: "302-B"
  creadoEn     DateTime @default(now())

  ordenes    OrdenMedica[]
  escenarios EscenarioEnfermeria[]

  @@map("pacientes_enfermeria")
}

// Orden médica que el estudiante debe verificar antes de administrar (los "5 correctos":
// paciente, medicamento, dosis, vía, hora).
model OrdenMedica {
  id            String             @id @default(cuid())
  pacienteId    String
  paciente      PacienteEnfermeria @relation(fields: [pacienteId], references: [id])
  medicamento   String
  dosis         String // ej: "500mg"
  via           String // ej: "Oral", "Intravenosa"
  frecuencia    String // ej: "Cada 8 horas"
  medico        String
  fechaEmision  DateTime
  fechaVigencia DateTime
  creadoEn      DateTime           @default(now())

  escenarios EscenarioEnfermeria[]

  @@map("ordenes_medicas")
}

// Extensión de Escenario específica del módulo Enfermería.
model EscenarioEnfermeria {
  id          String    @id @default(cuid())
  escenarioId String    @unique
  escenario   Escenario @relation(fields: [escenarioId], references: [id], onDelete: Cascade)

  pacienteId    String
  paciente      PacienteEnfermeria @relation(fields: [pacienteId], references: [id])
  ordenMedicaId String?
  ordenMedica   OrdenMedica?       @relation(fields: [ordenMedicaId], references: [id])
  contexto      String? // texto libre: turno, hallazgos al llegar al paciente, etc.

  @@map("escenarios_enfermeria")
}

// ---------- Módulo Primera Infancia ----------

// Niño ficticio evaluado en los casos de Primera Infancia.
model Nino {
  id     String   @id @default(cuid())
  nombre String
  // Edad real se deriva de fechaNacimiento. semanasGestacionNacimiento permite detectar
  // prematurez (<37 semanas) y calcular edad corregida en los casos que lo requieren.
  fechaNacimiento            DateTime
  semanasGestacionNacimiento Int?
  cuidadorNombre             String?
  antecedentes               String?
  esquemaVacunacionAlDia     Boolean  @default(true)
  vacunasPendientes          String[] @default([])
  creadoEn                   DateTime @default(now())

  registrosCrecimiento RegistroCrecimiento[]
  escenarios           EscenarioPrimeraInfancia[]

  @@map("ninos")
}

// Historial de peso/talla de un niño, para poder mostrar una tendencia (curva de
// crecimiento simplificada) en vez de un solo valor puntual.
model RegistroCrecimiento {
  id      String   @id @default(cuid())
  ninoId  String
  nino    Nino     @relation(fields: [ninoId], references: [id], onDelete: Cascade)
  fecha   DateTime
  pesoKg  Float
  tallaCm Float

  @@map("registros_crecimiento")
}

// Extensión de Escenario específica del módulo Primera Infancia.
model EscenarioPrimeraInfancia {
  id          String    @id @default(cuid())
  escenarioId String    @unique
  escenario   Escenario @relation(fields: [escenarioId], references: [id], onDelete: Cascade)

  ninoId   String
  nino     Nino    @relation(fields: [ninoId], references: [id])
  contexto String? // texto libre: motivo de consulta, hallazgos de la valoración

  // Lista de hitos a valorar en este caso: [{ "dominio": "Motricidad gruesa", "hito": "Camina solo" }, ...].
  // JSON en vez de tabla de catálogo aparte para mantener la siembra y calificación simples;
  // el checklist genérico matchea contra estos mismos pares vía PasoEsperado.parametros.
  hitosEsperados Json?

  @@map("escenarios_primera_infancia")
}

// Secuencia de varios escenarios encadenados con un solo pool de 3 vidas compartido
// entre todos — la "prueba final": simula la fatiga de atender casos uno tras otro.
model Turno {
  id                 String   @id @default(cuid())
  moduloId           String
  modulo             Modulo   @relation(fields: [moduloId], references: [id])
  titulo             String
  descripcion        String
  umbralDesbloqueo   Int      @default(70) // % mínimo (puntajeFinal) que se exige en cada caso normal para desbloquear
  requiereDesbloqueo Boolean  @default(false) // mientras esté en false, se muestra a todos sin exigir el umbral (para QA)
  activo             Boolean  @default(true)
  creadoEn           DateTime @default(now())

  items    TurnoItem[]
  intentos IntentoTurno[]

  @@map("turnos")
}

// Un escenario dentro de la secuencia de un turno, con su posición (orden).
model TurnoItem {
  id          String    @id @default(cuid())
  turnoId     String
  turno       Turno     @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  escenarioId String
  escenario   Escenario @relation(fields: [escenarioId], references: [id])
  orden       Int

  @@map("turno_items")
}

enum EstadoIntentoTurno {
  EN_PROGRESO
  COMPLETADO
  PERDIDO
}

// Una corrida de un estudiante a través de un Turno completo. Las vidas viven acá
// (no en cada Intento individual) y se reflejan en el Intento activo mientras dura.
model IntentoTurno {
  id           String             @id @default(cuid())
  usuarioId    String
  usuario      Usuario            @relation(fields: [usuarioId], references: [id])
  turnoId      String
  turno        Turno              @relation(fields: [turnoId], references: [id])
  estado       EstadoIntentoTurno @default(EN_PROGRESO)
  modo         ModoJuego          @default(FACIL) // se elige una vez al iniciar el turno; aplica a todos los casos
  vidas        Int                @default(3)
  indice       Int                @default(0) // posición actual dentro de la secuencia (0-based)
  puntajeFinal Float? // promedio de los puntajeFinal de cada caso completado dentro del turno
  iniciadoEn   DateTime           @default(now())
  finalizadoEn DateTime?

  intentos Intento[]

  @@map("intentos_turno")
}

// Un paso obligatorio dentro del checklist de calificación de un escenario. `tipoAccion`
// es un código de texto libre definido por el vocabulario del módulo del escenario
// (ej. Farmacia: "AGREGAR_A_VENTA"; Enfermería: "VERIFICAR_ORDEN_MEDICA"), no un enum de
// Postgres, para que cada módulo pueda definir sus propios verbos sin migración de schema.
model PasoEsperado {
  id          String    @id @default(cuid())
  escenarioId String
  escenario   Escenario @relation(fields: [escenarioId], references: [id], onDelete: Cascade)
  orden       Int // posición esperada (para bonificar/penalizar orden)
  tipoAccion  String
  descripcion String // texto humano, ej: "Verificó la receta antes de vender"
  parametros  Json? // condiciones específicas a matchear contra la Accion registrada
  obligatorio Boolean   @default(true)
  peso        Int       @default(1) // ponderación relativa dentro del puntaje de "proceso"

  @@map("pasos_esperados")
}

enum EstadoIntento {
  EN_PROGRESO
  COMPLETADO
  PERDIDO // se quedó sin corazones, debe reiniciar
}

enum ModoJuego {
  FACIL
  DIFICIL
}

// Una corrida de un estudiante sobre un escenario específico
model Intento {
  id           String        @id @default(cuid())
  usuarioId    String
  usuario      Usuario       @relation(fields: [usuarioId], references: [id])
  escenarioId  String
  escenario    Escenario     @relation(fields: [escenarioId], references: [id])
  estado       EstadoIntento @default(EN_PROGRESO)
  modo         ModoJuego     @default(FACIL)
  vidas        Int           @default(3)
  iniciadoEn   DateTime      @default(now())
  finalizadoEn DateTime?

  puntajeProceso   Float? // 0-100, basado en checklist de pasos
  puntajeResultado Float? // 0-100, basado en si el resultado final fue correcto
  puntajeFinal     Float? // ponderado: 60% proceso + 40% resultado

  // Código del resultado que efectivamente obtuvo el estudiante al finalizar (mismo
  // vocabulario que Escenario.resultadoEsperado); null mientras está EN_PROGRESO.
  resultadoObtenido String?

  intentoTurnoId String? // si no es null, este Intento es un caso dentro de un Turno (vidas compartidas)
  intentoTurno   IntentoTurno? @relation(fields: [intentoTurnoId], references: [id])

  acciones Accion[]

  @@map("intentos")
}

// Log crudo de cada acción que el estudiante realiza dentro de un intento. `tipo` es el
// mismo vocabulario de texto libre del módulo que PasoEsperado.tipoAccion.
model Accion {
  id         String   @id @default(cuid())
  intentoId  String
  intento    Intento  @relation(fields: [intentoId], references: [id], onDelete: Cascade)
  tipo       String
  payload    Json? // datos de la acción, ej: {"medicamentoId": "...", "cantidad": 2}
  esCorrecta Boolean? // evaluado contra el checklist al finalizar
  esError    Boolean  @default(false) // si esta acción costó un corazón en el momento
  creadoEn   DateTime @default(now())

  @@map("acciones")
}

// ==================== Turnero ====================
// Herramienta de administración (NO es un Modulo): sistema de turnos de atención tipo
// droguería/EPS, para practicar en sala de cómputo bajo la cuenta admin. Sin escenarios,
// checklist, vidas ni calificación. Ver docs/turnero.md.
//
// El modelo `Turno` de arriba (prueba final: escenarios encadenados) NO tiene relación
// con esto: distinto dominio, distinto vocabulario.

enum ReglaPrioridad {
  ESTRICTA // prioritarios primero, luego FIFO
  INTERCALADA // máx. 2 normales seguidos antes de meter un prioritario
}

enum EstadoSesionTurnero {
  ABIERTA
  CERRADA
}

enum EstadoEspacio {
  LIBRE
  LLAMANDO // llamó un turno, aún no confirma que llegó
  ATENDIENDO
  PAUSA
}

enum EstadoTicket {
  EN_ESPERA
  LLAMADO
  ATENDIDO
  NO_SE_PRESENTO
}

// Plantilla configurable de turnero (nº de espacios, servicios, categorías de prioridad).
model Turnero {
  id             String         @id @default(cuid())
  nombre         String
  numeroEspacios Int            @default(3)
  servicios      Json // [{ codigo, nombre, prefijo }]
  categorias     Json // [{ codigo, nombre }]; editable por plantilla
  reglaPrioridad ReglaPrioridad @default(ESTRICTA)
  activo         Boolean        @default(true)
  creadoEn       DateTime       @default(now())

  sesiones SesionTurnero[]

  @@map("turneros")
}

// Una corrida del turnero. Cerrarla archiva la cola; una nueva sesión arranca limpia.
model SesionTurnero {
  id             String              @id @default(cuid())
  turneroId      String
  turnero        Turnero             @relation(fields: [turneroId], references: [id])
  numeroEspacios Int // copia editable en vivo
  estado         EstadoSesionTurnero @default(ABIERTA)
  iniciadaEn     DateTime            @default(now())
  cerradaEn      DateTime?

  espacios Espacio[]
  tickets  Ticket[]

  @@map("sesiones_turnero")
}

model Espacio {
  id             String        @id @default(cuid())
  sesionId       String
  sesion         SesionTurnero @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  numero         Int
  nombre         String?
  estado         EstadoEspacio @default(LIBRE)
  ticketActualId String?       @unique
  ticketActual   Ticket?       @relation("TicketEnEspacio", fields: [ticketActualId], references: [id])

  @@unique([sesionId, numero])
  @@map("espacios_turnero")
}

model Ticket {
  id             String        @id @default(cuid())
  sesionId       String
  sesion         SesionTurnero @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  codigo         String // ej: "A-047"
  servicioCodigo String
  prioritario    Boolean       @default(false)
  categoria      String? // código de la categoría de prioridad, si aplica
  estado         EstadoTicket  @default(EN_ESPERA)
  espacioNumero  Int? // espacio que lo llamó
  emitidoEn      DateTime      @default(now())
  llamadoEn      DateTime?
  cerradoEn      DateTime?

  espacio Espacio? @relation("TicketEnEspacio")

  @@index([sesionId, estado])
  @@map("tickets_turnero")
}

// ==================== Dispensación (servicio farmacéutico) ====================
// Módulo-herramienta de práctica libre (NO calificado): el estudiante atiende una
// secuencia de pacientes que llegan a la ventanilla con fórmulas médicas físicas,
// busca al paciente en el sistema, coteja contra lo autorizado (RecetaElectronica) y
// dispensa (total o parcial). Sin escenarios, checklist, vidas ni nota. Ver docs/dispensacion.md.

// Un paciente que llega a la ventanilla con una o varias fórmulas en mano.
model CasoDispensacion {
  id                  String   @id @default(cuid())
  titulo              String
  contexto            String? // qué dice / pide el paciente
  pacienteId          String
  paciente            Paciente @relation("PacienteCasosDispensacion", fields: [pacienteId], references: [id])
  // Documento que muestra la persona en la ventanilla. Si difiere de paciente.cedula → suplantación.
  documentoPresentado String?
  orden               Int      @default(0)
  activo              Boolean  @default(true)
  creadoEn            DateTime @default(now())

  formulas FormulaPresentada[]
  entregas EntregaDispensacion[]

  @@map("casos_dispensacion")
}

// Una fórmula médica física que el paciente entrega. Se renderiza como documento.
model FormulaPresentada {
  id             String   @id @default(cuid())
  casoId         String
  caso           CasoDispensacion @relation(fields: [casoId], references: [id], onDelete: Cascade)
  medico         String
  registroMedico String
  ips            String?
  fechaEmision   DateTime
  diasVigencia   Int      @default(30)
  // false = receta de médico particular / no cargada al sistema de la EPS: no se dispensa por acá.
  cargadaEnSistema Boolean @default(true)
  nota           String? // contexto de una irregularidad ("cantidad corregida a mano", etc.)

  renglones RenglonFormula[]

  @@map("formulas_presentadas")
}

// Un renglón (medicamento) dentro de una fórmula física.
model RenglonFormula {
  id              String            @id @default(cuid())
  formulaId       String
  formula         FormulaPresentada @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  medicamentoId   String
  medicamento     Medicamento       @relation("MedicamentoRenglonesFormula", fields: [medicamentoId], references: [id])
  cantidad        Int // cantidad escrita en el papel
  cantidadTachada Int? // corrección a mano visible antes de la cantidad final
  posologia       String?

  entregas EntregaDispensacion[]

  @@map("renglones_formula")
}

// Una corrida de práctica de un estudiante: aísla su estado (qué ya entregó) del resto.
model SesionDispensacion {
  id         String   @id @default(cuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  indiceCaso Int      @default(0) // en qué caso de la secuencia va
  iniciadaEn DateTime @default(now())

  entregas EntregaDispensacion[]

  @@map("sesiones_dispensacion")
}

enum ResultadoEntrega {
  ENTREGADO
  RECHAZADO
}

// Lo que el estudiante hizo con un medicamento: entregó N unidades, o rechazó (con motivo).
model EntregaDispensacion {
  id                  String             @id @default(cuid())
  sesionId            String
  sesion              SesionDispensacion @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  casoId              String
  caso                CasoDispensacion   @relation(fields: [casoId], references: [id])
  renglonFormulaId    String?
  renglonFormula      RenglonFormula?    @relation(fields: [renglonFormulaId], references: [id])
  medicamentoId       String
  medicamento         Medicamento        @relation("MedicamentoEntregasDispensacion", fields: [medicamentoId], references: [id])
  cantidad            Int
  resultado           ResultadoEntrega
  motivo              String?
  // Autorización del sistema contra la que se hizo la entrega (para descontar saldo).
  recetaElectronicaId String?
  recetaElectronica   RecetaElectronica? @relation("RecetaEntregas", fields: [recetaElectronicaId], references: [id])
  creadoEn            DateTime           @default(now())

  @@index([sesionId])
  @@map("entregas_dispensacion")
}
